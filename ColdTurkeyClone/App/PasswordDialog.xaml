<Window x:Class="ColdTurkeyClone.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha" Height="160" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="Digite a senha:" Margin="0,0,0,8"/>
        <PasswordBox x:Name="PasswordInput" Padding="4"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Padding="10,4" Click="Cancel_Click"/>
            <Button Content="OK" Padding="10,4" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
