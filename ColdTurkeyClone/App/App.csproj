<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- só pra NotifyIcon (ícone da bandeja) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ColdTurkeyClone</AssemblyName>
    <RootNamespace>ColdTurkeyClone</RootNamespace>

    <!-- Self-contained: empacota o próprio .NET Runtime junto, então quem
         for rodar o .exe NÃO precisa instalar o .NET separadamente (era isso
         que causava aquele aviso "instale o .NET" que você viu). Só tem
         efeito com "dotnet publish" (não com "dotnet build") — ver README. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
