{
  "manifest_version": 3,
  "name": "Cold Turkey Clone - Bloqueio por Palavra-chave",
  "version": "1.0",
  "description": "Bloqueia páginas cuja URL ou conteúdo contenha palavras-chave definidas no app Cold Turkey Clone, enquanto o bloqueio estiver ativo.",
  "key": "",
  "permissions": ["tabs", "webNavigation", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1:57411/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
